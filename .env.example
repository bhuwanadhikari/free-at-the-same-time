# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# These identify your Firebase project; they are not secrets, but keep real values out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# Set to "true" to talk to the local Firebase Emulator Suite instead of production.
VITE_USE_EMULATORS=false
